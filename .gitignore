# virtualenv + caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# runtime telemetry (live bot state, audit trail, logs) - never in history
outputs/

# harness/session files: project hooks/settings ARE committed (they carry
# the web-session bootstrap + learning-continuity import); only per-machine
# local overrides stay out of history.
.claude/settings.local.json
.claude/*.local.*

# pre-cut config backups written by scripts/boundary5_stage.py --apply
# (and any future stager following its shape). Untracked on purpose:
# config.json itself is tracked, so the backup adds no history value -
# but an accidental `git add -A` would commit it as a confusing second
# config. NOTE the restore hazard documented at the backup write site in
# boundary5_stage.py: hand-restoring one of these does not revert
# EXEC_ERA and silently poisons era comparability.
config.json.pre-*

# packaged deliverables
*.zip

# OS noise
Thumbs.db
.DS_Store

# session scratch from shell redirects. `err1.log` (0 bytes) sat untracked at
# the root for a day; zero .log files are tracked, so this rule can never
# shadow a real artifact. The sibling hazard has no ignore rule because it
# CANNOT have one: a Windows file literally named NUL - created when a bash
# redirect writes to `2>NUL` instead of `2>/dev/null` - makes `git add -A`
# abort with `fatal: mmap failed: Invalid argument` (measured rc=128, after
# listing only 18 of 26 paths, so a real `add -A` stages a PARTIAL set and
# reports failure). It is unlinkable through Git Bash, which resolves the
# name to the null device and silently no-ops; delete it from PowerShell:
#     cmd /c del "\\?\<repo>\NUL"
*.log

# superpowers: isolated worktrees for parallel/pinned analysis
.worktrees/
# Claude Code isolation worktrees live INSIDE the repo (.claude/worktrees/
# <name>). They are full checkouts, so a secret scan reports every finding
# twice and a stale one can be mistaken for live code - observed 2026-08-01,
# 3 of 6 scan hits were duplicates from .claude/worktrees/.
.claude/worktrees/

# secrets: this project resolves every credential from an environment
# variable NAME or a file OUTSIDE the repo (~/.liquiditybot/*), so no dotenv
# is used today. Ignored anyway - the cost of the line is zero and the cost
# of the first .env someone drops here is a rotated Kraken key.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# protoc output for the optional gRPC surface (api/liquiditybot.proto).
# Generated at build time and deliberately untracked; without this line a
# local `protoc` run makes build artifacts committable by accident.
api/liquiditybot_pb2.py
api/liquiditybot_pb2_grpc.py
api/liquiditybot_pb2.pyi

# subagent-driven-development session ledger (scratch, never code history)
.superpowers/

# 09-22 prep artifacts: 589MB research corpus + vendored reference clone
research/corpus/
research/vendor/

# local tooling / never commit
research/
.playwright-mcp/
