{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "terminal.integrated.env.windows": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "outputs/audit.jsonl": true,
    "outputs/state.json*": true,
    ".pytest_cache": true,
    ".ruff_cache": true,
    ".worktrees": true,
    ".mythos": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "config.json": "config.json.pre-*",
    "README.md": "README_WINDOWS.md",
    "pyproject.toml": "pyrightconfig.json, requirements.txt, .markdownlint.json",
    ".gitignore": ".gitattributes",
    "start.bat": "start.sh, stop.bat, stop.sh, restart.bat",
    "install.bat": "install.sh"
  },
  "search.exclude": {
    "outputs/**": true,
    ".venv/**": true
  },
  "C_Cpp.default.cppStandard": "c++17"
}
