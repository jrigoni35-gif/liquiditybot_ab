      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "pair",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(pair|Value.*)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "Value #A": "Promoted"
            },
            "indexByName": {
              "pair": 0,
              "Promoted": 1
            }
          }
        }
      ],
      "transparent": true
