    {
      "id": 100,
      "type": "timeseries",
      "title": "Model Brier vs baseline",
      "description": "OUTCOME health: rolling Brier of the DEPLOYED model vs the base-rate baseline on the last judged trades (lower=better). Model ABOVE baseline = worse than a naive guess; the governor kills at baseline+0.03. Absent until >=15 trades judgeable.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max(liquiditybot_ml_brier{job=\"liquiditybot\"})",
          "instant": false,
          "range": true,
          "legendFormat": "model brier"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max(liquiditybot_ml_baseline_brier{job=\"liquiditybot\"})",
          "instant": false,
          "range": true,
          "legendFormat": "baseline (base-rate)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max(liquiditybot_ml_champion_brier{job=\"liquiditybot\"})",
          "instant": false,
          "range": true,
          "legendFormat": "champion (deploy bar)"
        }
      ]
    },
