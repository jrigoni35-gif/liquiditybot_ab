      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true,
              "Value": true
            },
            "renameByName": {},
            "indexByName": {
              "asset": 0,
              "macro": 1,
              "vol": 2,
              "liq": 3
            }
          }
        }
      ]
