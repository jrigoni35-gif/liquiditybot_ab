{
  "uid": "liquiditybot-signals",
  "title": "liquiditybot — signals & edge",
  "description": "Signal confidence/urgency, gate pass-rates and learned weights, manipulation defense, regimes.",
  "tags": [
    "liquiditybot",
    "trading",
    "paper-trading"
  ],
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 4,
      "type": "row",
      "title": "§4 · Signal & Edge",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 80,
      "type": "timeseries",
      "title": "Signal confidence (per asset)",
      "description": "Meta-model p(win) per asset — the continuous conviction line.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 6,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (asset) (liquiditybot_signal_confidence{job=\"liquiditybot\"})",
          "instant": false,
          "legendFormat": "{{asset}}"
        }
      ]
    },
    {
      "id": 81,
      "type": "timeseries",
      "title": "Signal urgency (per asset)",
