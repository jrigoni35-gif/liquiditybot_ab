          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "100 * max(liquiditybot_fees_total{job=\"liquiditybot\"}) / clamp_min(max(liquiditybot_perf_gross_profit_usd{job=\"liquiditybot\"}), 0.001)",
          "instant": true
        }
      ]
    },
