    "liquiditybot",
    "trading",
    "paper-trading"
  ],
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 3,
      "type": "row",
      "title": "§3 · Execution Quality",
      "collapsed": false,
