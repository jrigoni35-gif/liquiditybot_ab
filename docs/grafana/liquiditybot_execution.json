    {
      "id": 2,
      "type": "stat",
      "title": "Brier gap vs baseline",
      "description": "model Brier MINUS baseline Brier. This IS the firing condition of liquiditybot_brier_alert.yaml (> 0.03). Last real reading 2026-08-06: 0.0547 - already over the line.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#30D158",
                "value": null
              },
              {
                "color": "#FF453A",
                "value": 0.03
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "window filling (<15 model-scored closes)"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "text": {
          "titleSize": 16,
          "valueSize": 56
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max(liquiditybot_ml_brier{job=\"liquiditybot\"}) - max(liquiditybot_ml_baseline_brier{job=\"liquiditybot\"})",
          "instant": false,
          "range": true,
          "legendFormat": ""
        }
