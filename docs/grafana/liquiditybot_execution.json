    {
      "id": 130,
      "type": "bargauge",
      "title": "Candidate tradability scores",
      "description": "Skimmer ranking of the candidate pool (spread cost 40% / book depth 35% / bar activity 25%; thresholds in config). At or above promote_score (0.55) a candidate is eligible for the active universe.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.35
              },
              {
                "color": "green",
                "value": 0.55
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "max by (pair) (liquiditybot_skimmer_score{job=\"liquiditybot\"})",
          "instant": false,
          "legendFormat": "{{pair}}"
        }
      ]
    },
