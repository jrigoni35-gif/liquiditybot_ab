{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python scripts/smoke_test.py)",
      "Bash(.venv/bin/python scripts/assurance_check.py)",
      "Bash(.venv/bin/python scripts/overfit_check.py)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(ruff check *)",
      "Bash(/root/.local/bin/pyright *)",
      "Bash(.venv/bin/bandit *)",
      "Bash(.venv/bin/python -m compileall *)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe scripts/smoke_test.py)",
      "Bash(.venv/Scripts/python.exe scripts/assurance_check.py)",
      "Bash(.venv/Scripts/python.exe scripts/overfit_check.py)",
      "Bash(.venv/Scripts/python.exe scripts/vscode_bridge.py *)",
      "Bash(.venv/Scripts/python.exe -m ruff check *)",
      "Bash(.venv/Scripts/python.exe -m compileall *)",
      "Bash(.venv/Scripts/ruff.exe check *)",
      "Bash(.venv/Scripts/bandit.exe *)",
      "Bash(npx pyright *)",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__list_triggers"
    ]
  }
}
